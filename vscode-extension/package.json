{
  "name": "nativecopy",
  "displayName": "NativeCopy // Live Remote Cursor, Directory Injection & Clipboard Sync",
  "description": "Live real-time code insertion directly into your active VS Code editor & native directory file injection from Mobile / Web",
  "version": "1.0.0",
  "publisher": "muhmdathalla",
  "engines": {
    "vscode": "^1.60.0"
  },
  "categories": [
    "Other",
    "Snippets",
    "Programming Languages"
  ],
  "main": "./extension.js",
  "activationEvents": [
    "*"
  ],
  "contributes": {
    "commands": [
      {
        "command": "nativecopy.connect",
        "title": "Connect Account / Set Token",
        "category": "NativeCopy"
      },
      {
        "command": "nativecopy.teleportSelection",
        "title": "⚡ Teleport Selection to Mobile Screen",
        "category": "NativeCopy"
      },
      {
        "command": "nativecopy.uploadActiveFile",
        "title": "📁 Upload Active File to Mobile",
        "category": "NativeCopy"
      },
      {
        "command": "nativecopy.sendSelection",
        "title": "Send Selected Code to Cloud Clipboard",
        "category": "NativeCopy"
      },
      {
        "command": "nativecopy.insertLatest",
        "title": "Insert Latest Snippet",
        "category": "NativeCopy"
      },
      {
        "command": "nativecopy.toggleAutoInsert",
        "title": "Toggle Remote Auto-Insert (On/Off)",
        "category": "NativeCopy"
      }
    ],
    "keybindings": [
      {
        "command": "nativecopy.teleportSelection",
        "key": "alt+cmd+t",
        "mac": "alt+cmd+t",
        "win": "alt+ctrl+t",
        "when": "editorHasSelection"
      },
      {
        "command": "nativecopy.uploadActiveFile",
        "key": "alt+cmd+u",
        "mac": "alt+cmd+u",
        "win": "alt+ctrl+u"
      }
    ],
    "menus": {
      "editor/context": [
        {
          "command": "nativecopy.teleportSelection",
          "group": "NativeCopy@1",
          "when": "editorHasSelection"
        },
        {
          "command": "nativecopy.uploadActiveFile",
          "group": "NativeCopy@2"
        },
        {
          "command": "nativecopy.sendSelection",
          "group": "NativeCopy@3",
          "when": "editorHasSelection"
        }
      ],
      "explorer/context": [
        {
          "command": "nativecopy.uploadActiveFile",
          "group": "NativeCopy"
        }
      ]
    },
    "configuration": {
      "type": "object",
      "title": "NativeCopy Configuration",
      "properties": {
        "nativecopy.serverUrl": {
          "type": "string",
          "default": "https://nativecopy.vercel.app",
          "description": "NativeCopy Server URL (Vercel cloud or local http://192.168.x.x:8080)"
        },
        "nativecopy.token": {
          "type": "string",
          "default": "",
          "description": "Your NativeCopy Account Token (can be set via Command Palette: NativeCopy Connect)"
        },
        "nativecopy.autoInsert": {
          "type": "boolean",
          "default": true,
          "description": "Automatically insert text received from Mobile / Web into the active VS Code cursor position"
        },
        "nativecopy.autoOpenInjectedFiles": {
          "type": "boolean",
          "default": true,
          "description": "Automatically open files received from Mobile in the VS Code editor tab"
        }
      }
    }
  }
}
